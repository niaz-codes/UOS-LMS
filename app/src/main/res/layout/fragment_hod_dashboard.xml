<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.UOS_LMS.Hod"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        android:title="@string/hod_dashboard_fallback_title"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:menu="@menu/menu_top_logout" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <include android:id="@+id/emptyState" layout="@layout/layout_empty_state" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <include
                    android:id="@+id/gradientHeader"
                    layout="@layout/layout_gradient_header_hod" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/overview"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/overviewGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/statStudents"
                            layout="@layout/item_premium_overview_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/statTeachers"
                            layout="@layout/item_premium_overview_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/statStudentAttendance"
                            layout="@layout/item_premium_overview_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/statReports"
                            layout="@layout/item_premium_overview_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/manage"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:layoutAnimation="@anim/layout_animation_fall_down">

                    <include android:id="@+id/actionTeachers" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionStudents" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionAttendance" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionReports" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionAssignmentMonitor" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionQuizMonitor" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionExamResultApprovals" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionResults" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionRepeatExamReview" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionLeave" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionTeacherLeave" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionTimetable" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionExamSchedule" layout="@layout/item_action_card" />
                    <include android:id="@+id/actionMessaging" layout="@layout/item_action_card" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/hod_semesters_section_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textNoSemesters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:text="@string/no_semesters_in_your_department"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/semestersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_bottom_nav_floating"
        android:elevation="10dp"
        app:itemIconTint="@color/bottom_nav_item_color_hod"
        app:itemTextColor="@color/bottom_nav_item_color_hod"
        app:itemActiveIndicatorStyle="@style/Widget.UOS_LMS.BottomNavigation.ActiveIndicator.Hod"
        app:menu="@menu/menu_hod_bottom_nav" />

</LinearLayout>
