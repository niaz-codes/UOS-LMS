<?xml version="1.0" encoding="utf-8"?>
<!-- One premium Overview stat card - Total Students/Teachers/HODs/Departments, arranged as a
     compact 2x2 grid. Card background is the role's soft "container" tint (already tuned
     per-theme in colors.xml/values-night), the icon badge is the same accent at full saturation
     for contrast, and a low-alpha glow + a couple of faint decorative circles sit behind
     everything for depth. Bound entirely in code (AdminHomeFragment#bindOverviewCard) since the
     accent/icon/copy differ per card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/glowHalo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-14dp"
        android:layout_marginEnd="-14dp"
        android:background="@drawable/bg_glow_radial" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:cardPreventCornerOverlap="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/decorShapeLarge"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-28dp"
                android:layout_marginEnd="-28dp"
                android:alpha="0.12"
                android:background="@drawable/shape_circle_solid" />

            <View
                android:id="@+id/decorShapeSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.1"
                android:background="@drawable/shape_circle_solid" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp">

                    <View
                        android:id="@+id/iconBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_status_icon_circle" />

                    <ImageView
                        android:id="@+id/imageIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />

                </FrameLayout>

                <TextView
                    android:id="@+id/textLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="0"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textTrend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawablePadding="3dp"
                        android:gravity="center_vertical"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <com.example.uos_lms.core.ui.TrendSparklineView
                        android:id="@+id/sparkline"
                        android:layout_width="38dp"
                        android:layout_height="18dp" />

                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
