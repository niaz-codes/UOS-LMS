<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.UOS_LMS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/indigo_primary</item>
        <item name="colorOnPrimary">@color/on_indigo_primary</item>
        <item name="colorPrimaryContainer">@color/indigo_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_indigo_primary_container</item>

        <item name="colorSecondary">@color/emerald_secondary</item>
        <item name="colorOnSecondary">@color/on_emerald_secondary</item>
        <item name="colorSecondaryContainer">@color/emerald_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_emerald_secondary_container</item>

        <item name="colorTertiary">@color/amber_tertiary</item>
        <item name="colorOnTertiary">@color/on_amber_tertiary</item>
        <item name="colorTertiaryContainer">@color/amber_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_amber_tertiary_container</item>

        <item name="colorError">@color/error_color</item>
        <item name="colorOnError">@color/on_error_color</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>

        <item name="android:colorBackground">@color/background_color</item>
        <item name="colorOnBackground">@color/on_background_color</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnSurface">@color/on_surface_color</item>
        <item name="colorSurfaceVariant">@color/surface_variant_color</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_color</item>
        <item name="colorOutline">@color/outline_color</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.UOS_LMS.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.UOS_LMS.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.UOS_LMS.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.UOS_LMS.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.UOS_LMS.ExtraLarge</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="bottomNavigationStyle">@style/Widget.UOS_LMS.BottomNavigation</item>

        <!-- Typography scale - tighter letter-spacing and a medium/bold weight on the tiers
             used for screen titles, toolbar titles, and section headers gives real visual
             hierarchy without needing a bundled custom font; body/label tiers stay close to
             the M3 baseline for readability. Wiring these as theme defaults means every widget
             that doesn't already set its own textAppearance (Toolbar titles, MaterialButton
             labels, TextInputLayout hints, etc.) picks this up automatically app-wide. -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.UOS_LMS.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.UOS_LMS.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.UOS_LMS.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.UOS_LMS.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.UOS_LMS.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.UOS_LMS.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.UOS_LMS.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.UOS_LMS.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.UOS_LMS.LabelLarge</item>

        <!-- Component defaults - anything that doesn't explicitly override its own style
             (app:cardCornerRadius, style="...", etc.) now inherits the premium treatment
             instead of bare Material3 defaults. Screens with explicit per-instance overrides
             are untouched by this - see the accompanying summary for what that leaves out. -->
        <item name="materialCardViewStyle">@style/Widget.UOS_LMS.Card</item>
        <item name="materialButtonStyle">@style/Widget.UOS_LMS.Button</item>
        <item name="textInputStyle">@style/Widget.UOS_LMS.TextInputLayout</item>
    </style>

    <!-- Premium floating bottom nav: selected-only labels + a pill active indicator let
         Material3's own built-in NavigationBar selection motion (indicator fade/scale, icon
         shift, label fade-in) do the animation work, instead of bespoke per-item Java code that
         would risk interfering with the existing, untouched navigation/menu logic. -->
    <style name="Widget.UOS_LMS.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="labelVisibilityMode">selected</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.UOS_LMS.BottomNavigation.ActiveIndicator</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.UOS_LMS.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="marginHorizontal">18dp</item>
    </style>

    <!-- Per-role active-indicator pill, applied via app:itemActiveIndicatorStyle on each role
         dashboard's BottomNavigationView instance (see UI_UX_Design/ reference) - paired with
         the matching bottom_nav_item_color_<role>.xml selector for the icon/label tint. -->
    <style name="Widget.UOS_LMS.BottomNavigation.ActiveIndicator.Admin">
        <item name="android:color">@color/admin_container</item>
        <item name="marginHorizontal">18dp</item>
    </style>
    <style name="Widget.UOS_LMS.BottomNavigation.ActiveIndicator.Hod">
        <item name="android:color">@color/hod_container</item>
        <item name="marginHorizontal">18dp</item>
    </style>
    <style name="Widget.UOS_LMS.BottomNavigation.ActiveIndicator.Teacher">
        <item name="android:color">@color/teacher_container</item>
        <item name="marginHorizontal">18dp</item>
    </style>
    <style name="Widget.UOS_LMS.BottomNavigation.ActiveIndicator.Student">
        <item name="android:color">@color/student_container</item>
        <item name="marginHorizontal">18dp</item>
    </style>

    <!-- Per-role theme overlays - applied via android:theme on a role screen's root view so
         ?attr/colorPrimary (buttons, FABs, focused fields, checkboxes, etc.) resolves to that
         role's brand color instead of the app-wide neutral Indigo default. See UI_UX_Design/. -->
    <style name="ThemeOverlay.UOS_LMS.Admin" parent="">
        <item name="colorPrimary">@color/role_admin_start</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/admin_container</item>
        <item name="colorOnPrimaryContainer">@color/on_admin_container</item>
    </style>
    <style name="ThemeOverlay.UOS_LMS.Hod" parent="">
        <item name="colorPrimary">@color/role_hod_start</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/hod_container</item>
        <item name="colorOnPrimaryContainer">@color/on_hod_container</item>
    </style>
    <style name="ThemeOverlay.UOS_LMS.Teacher" parent="">
        <item name="colorPrimary">@color/role_teacher_start</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teacher_container</item>
        <item name="colorOnPrimaryContainer">@color/on_teacher_container</item>
    </style>
    <style name="ThemeOverlay.UOS_LMS.Student" parent="">
        <item name="colorPrimary">@color/role_student_start</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/student_container</item>
        <item name="colorOnPrimaryContainer">@color/on_student_container</item>
    </style>

    <!-- The image-cropper library's CropImageActivity has no Toolbar of its own - it hosts
         Crop (confirm) and the back-arrow (cancel) purely through getSupportActionBar(), which
         is null under our app-wide NoActionBar theme. Without this override the whole action
         bar - and both controls - never renders at all, not just low-contrast. -->
    <style name="Theme.UOS_LMS.Cropper" parent="Theme.UOS_LMS">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <style name="ShapeAppearance.UOS_LMS.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.UOS_LMS.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.UOS_LMS.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.UOS_LMS.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearance.UOS_LMS.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">32dp</item>
    </style>

    <style name="ShapeAppearance.UOS_LMS.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Typography scale - medium weight + slightly tightened letter-spacing on the tiers used
         for titles/headers gives real hierarchy without a bundled custom font; body/label tiers
         stay close to the M3 baseline (Roboto) for readability. -->
    <style name="TextAppearance.UOS_LMS.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.UOS_LMS.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.UOS_LMS.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.UOS_LMS.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.UOS_LMS.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.UOS_LMS.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.UOS_LMS.BodyLarge" parent="TextAppearance.Material3.BodyLarge" />
    <style name="TextAppearance.UOS_LMS.BodyMedium" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.UOS_LMS.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Component defaults - only apply to widgets that don't already set their own explicit
         per-instance style/attributes (many existing cards/dialogs do, see the design-pass
         summary for what that leaves out of this change). -->
    <style name="Widget.UOS_LMS.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="Widget.UOS_LMS.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.UOS_LMS.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/field_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/field_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/field_corner_radius</item>
    </style>

    <!-- Auth glass-card text field: white hairline outline/hint over the gradient hero
         background, matching the Compose glassTextFieldColors() look. -->
    <style name="AuthTextFieldLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/auth_field_stroke_color</item>
        <item name="hintTextColor">@color/white_alpha_85</item>
        <item name="android:textColorHint">@color/white_alpha_85</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="errorTextColor">@color/white</item>
        <item name="errorIconTint">@color/white</item>
        <item name="boxBackgroundColor">@color/white_alpha_14</item>
        <item name="endIconTint">@color/white_alpha_85</item>
        <item name="startIconTint">@color/white_alpha_85</item>
    </style>

    <style name="AuthPrimaryButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/indigo_primary</item>
    </style>

    <style name="AuthTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AuthDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginVertical">20dp</item>
        <item name="android:background">@color/white_alpha_22</item>
    </style>

    <!-- Small caps-style label above a grouped card section (Settings screen: "ACCOUNT",
         "APPEARANCE", etc.) - reusable anywhere a screen groups cards under a labeled section. -->
    <style name="SectionHeaderLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
