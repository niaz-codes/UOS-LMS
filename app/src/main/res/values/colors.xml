<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand palette - Indigo/Emerald/Amber stays the neutral/default chrome for role-agnostic
         screens (auth, settings, messaging, calendar, notifications). Role identity now comes
         from the per-role palette below (see UI_UX_Design/ reference), not this one. -->
    <color name="indigo_primary">#FF4F46E5</color>
    <color name="indigo_primary_dark">#FF3730A3</color>
    <color name="on_indigo_primary">#FFFFFFFF</color>
    <color name="indigo_primary_container">#FFE0E1FF</color>
    <color name="on_indigo_primary_container">#FF2B2483</color>

    <color name="emerald_secondary">#FF0D9488</color>
    <color name="on_emerald_secondary">#FFFFFFFF</color>
    <color name="emerald_secondary_container">#FFCCFBF1</color>
    <color name="on_emerald_secondary_container">#FF0F3D39</color>

    <color name="amber_tertiary">#FFB45309</color>
    <color name="on_amber_tertiary">#FFFFFFFF</color>
    <color name="amber_tertiary_container">#FFFEF3C7</color>
    <color name="on_amber_tertiary_container">#FF78350F</color>

    <color name="error_color">#FFDC2626</color>
    <color name="on_error_color">#FFFFFFFF</color>
    <color name="error_container">#FFFEE2E2</color>
    <color name="on_error_container">#FF7F1D1D</color>

    <color name="background_color">#FFF7F7FC</color>
    <color name="on_background_color">#FF1A1B2E</color>
    <color name="surface_color">#FFFFFFFF</color>
    <color name="on_surface_color">#FF1A1B2E</color>
    <color name="surface_variant_color">#FFE7E6F5</color>
    <color name="on_surface_variant_color">#FF49475E</color>
    <color name="outline_color">#FF9997B0</color>

    <!-- Role-branding accents (login role chips, gradient toolbars/headers, per-role bottom nav,
         per-role ThemeOverlay - see UI_UX_Design/ reference). Deliberately identical light/dark,
         same as before - a saturated brand color reads the same regardless of theme. -->
    <color name="role_admin_start">#FFE11D48</color>
    <color name="role_admin_end">#FFBE123C</color>
    <color name="role_hod_start">#FF9333EA</color>
    <color name="role_hod_end">#FF7C3AED</color>
    <color name="role_teacher_start">#FF2563EB</color>
    <color name="role_teacher_end">#FF1D4ED8</color>
    <color name="role_student_start">#FF16A34A</color>
    <color name="role_student_end">#FF15803D</color>

    <!-- Role "container" pairs (soft tint + readable-on-tint text) - stat card icon badges,
         role tags, anywhere a role needs a subtle background rather than the full gradient. -->
    <color name="admin_container">#FFFFE4E6</color>
    <color name="on_admin_container">#FF9F1239</color>
    <color name="hod_container">#FFF3E8FF</color>
    <color name="on_hod_container">#FF6B21A8</color>
    <color name="teacher_container">#FFDBEAFE</color>
    <color name="on_teacher_container">#FF1E40AF</color>
    <color name="student_container">#FFDCFCE7</color>
    <color name="on_student_container">#FF166534</color>

    <!-- Status semantics (assignment/quiz/leave/result states) - independent of role, used for
         pill badges and accent bars: live/active/graded/approved=success, upcoming/pending=
         warning, submitted/info=info, closed/completed/rejected reuse colorOnSurfaceVariant/error. -->
    <color name="status_success">#FF16A34A</color>
    <color name="status_warning">#FFD97706</color>
    <color name="status_info">#FF2563EB</color>

    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="white_alpha_85">#D9FFFFFF</color>
    <color name="white_alpha_22">#38FFFFFF</color>
    <color name="white_alpha_14">#24FFFFFF</color>
    <color name="scrim_overlay">#66000000</color>
</resources>
