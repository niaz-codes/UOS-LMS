<?xml version="1.0" encoding="utf-8"?>
<!-- Soft-fill status badge (see UI_UX_Design/ reference: LIVE/UPCOMING/Graded/Submitted/etc.) -
     a GradientDrawable so AccentColors.applyPill() can mutate() + set a translucent fill and a
     full-opacity stroke/text in the matching status color at runtime. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/status_info" />
    <stroke
        android:width="1dp"
        android:color="@color/status_info" />
    <corners android:radius="999dp" />
    <padding
        android:left="10dp"
        android:top="4dp"
        android:right="10dp"
        android:bottom="4dp" />
</shape>
