PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=uos_lms

JWT_SECRET=<random-long-secret>
JWT_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Student numbering (see services/studentNumbering.js) - all optional with sane defaults.
# Registration number = "UOS-<year>-<seq>", roll number = "<deptCode>-<sessionStartYear>-<seq>".
# REGISTRATION_NUMBER_YEAR=<year>            # pin the admission year (default: current year)
# REGISTRATION_SEQUENCE_START=1              # first registration sequence number
# REGISTRATION_SEQUENCE_PADDING=4            # zero-pad registration sequence width
# ROLL_NUMBER_SEQUENCE_START=1               # first roll sequence number per cohort
# ROLL_NUMBER_SEQUENCE_PADDING=3             # zero-pad roll sequence width
