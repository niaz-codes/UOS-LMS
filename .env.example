PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (e.g. https://admin.example.com,https://app.example.com).
# Leave unset to allow any origin - the safe default for this API, since it's primarily consumed
# by the Android app (which doesn't send/enforce an Origin header).
# CORS_ORIGIN=

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=uos_lms

JWT_SECRET=<random-long-secret>
JWT_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Optional - enables server-side push notifications (src/config/firebaseAdmin.js). Paste the
# entire Firebase service account JSON key file's contents as a single-line string. When unset,
# push notifications are silently disabled and in-app notifications keep working.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# Optional - enables outgoing email (src/services/email.js: password reset, etc.). When
# SMTP_HOST is unset, sendMail() throws only if/when something tries to send an email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<smtp-username>
# SMTP_PASS=<smtp-password>
# SMTP_FROM=UOS LMS <no-reply@example.com>

# Student numbering (see services/studentNumbering.js) - all optional with sane defaults.
# Registration number = "UOS-<year>-<seq>", roll number = "<deptCode>-<sessionStartYear>-<seq>".
# REGISTRATION_NUMBER_YEAR=<year>            # pin the admission year (default: current year)
# REGISTRATION_SEQUENCE_START=1              # first registration sequence number
# REGISTRATION_SEQUENCE_PADDING=4            # zero-pad registration sequence width
# ROLL_NUMBER_SEQUENCE_START=1               # first roll sequence number per cohort
# ROLL_NUMBER_SEQUENCE_PADDING=3             # zero-pad roll sequence width

# Only read by `npm run seed:admin` (a one-off bootstrap script, not the running server) -
# all optional with defaults baked into src/scripts/seedAdmin.js.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
# SEED_ADMIN_UID=
# SEED_ADMIN_CNIC=
# SEED_ADMIN_PHONE=
